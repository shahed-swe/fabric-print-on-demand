# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5001
NODE_ENV=development
# Production: NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fabric-print-on-demand
# Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# OpenAI API Key (for design features)
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key

# File Upload Configuration
UPLOAD_API_URL=http://localhost:5001
# Production: UPLOAD_API_URL=https://backend.customprintingservices.com.au
UPLOADS_DIR=./uploads

# MinIO Configuration (for S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=uploads
# Production endpoints
# MINIO_ENDPOINT=minio.customprintingservices.com.au
# MINIO_PORT=443

# Email Configuration (Brevo/Sendinblue SMTP)
EMAIL_SERVICE=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASSWORD=your_brevo_smtp_password
BREVO_FROM_EMAIL=noreply@customprintingservices.com.au
BREVO_FROM_NAME=Fabric Print on Demand

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://customprintingservices.com.au
